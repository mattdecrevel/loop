{
  "name": "@mattdecrevel/loop",
  "version": "0.6.0",
  "description": "Thin fail-open client for the Loop notification service. Typed Slack-event SDK for routing notifications through one Slack bot, with rich Block Kit rendering server-side.",
  "license": "MIT",
  "author": "Matt Decrevel <matt@mattdecrevel.com>",
  "homepage": "https://github.com/mattdecrevel/loop#readme",
  "bugs": "https://github.com/mattdecrevel/loop/issues",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattdecrevel/loop.git",
    "directory": "packages/client"
  },
  "keywords": [
    "slack",
    "notifications",
    "alerts",
    "block-kit",
    "fail-open",
    "typescript",
    "webhook",
    "notification-service"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
